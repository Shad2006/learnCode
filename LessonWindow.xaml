<Window x:Class="LearnCodeWPF.LessonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        Title="Урок" Height="700" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="LightGray" BorderThickness="0,0,0,2">
            <Grid>
                <Button Content="← Назад" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Click="BackButton_Click"
                        HorizontalAlignment="Left"
                        Margin="20,0"/>
                <TextBlock x:Name="txtLessonTitle" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <WindowsFormsHost Grid.Row="1" Margin="20">
            <wf:WebBrowser x:Name="webBrowser"/>
        </WindowsFormsHost>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Button Content="Степан, обьясни иначе" 
            Background="#FF9600" 
            Foreground="White"
            FontSize="14" FontWeight="Bold" 
            Width="180" Height="50" 
            Margin="0,0,20,0"
            Click="ExplainSimpler_Click"/>
            <Button Content="Перейти к вопросам" 
            Background="#58CC02" 
            Foreground="White"
            FontSize="14" FontWeight="Bold" 
            Width="180" Height="50"
            Click="StartQuiz_Click"/>
        </StackPanel>
    </Grid>
</Window>