<Window x:Class="LearnCodeWPF.LessonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        Title="Урок" Height="700" Width="900"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#7AC70C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="LightGray" BorderThickness="0,0,0,2">
            <Grid>
                <Button Content="← Назад" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Click="BackButton_Click"
                        HorizontalAlignment="Left"
                        Margin="20,0"/>
                <TextBlock x:Name="txtLessonTitle" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <WindowsFormsHost Grid.Row="1" Margin="20">
            <wf:WebBrowser x:Name="webBrowser"/>
        </WindowsFormsHost>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Button Content="Степан, обьясни иначе" 
                    Style="{StaticResource ModernButton}"
            Background="DarkCyan" 
            Foreground="White"
            FontSize="14" FontWeight="Bold" 
            Width="233" Height="50" 
            Margin="0,5,20,5"
            Click="ExplainSimpler_Click"/>
            <Button Content="Перейти к вопросам" 
                    Style="{StaticResource ModernButton}"
            Background="#58CC02" 
            Foreground="White"
            FontSize="14" FontWeight="Bold" 
            Width="252" Height="50"
            Click="StartQuiz_Click" Margin="0,5"/>
        </StackPanel>
    </Grid>
</Window>