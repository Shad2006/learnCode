<Window x:Class="LearnCodeWPF.LessonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        Title="Урок" Height="700" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель с заголовком и кнопкой назад -->
        <Border Grid.Row="0" Background="White" BorderBrush="LightGray" BorderThickness="0,0,0,2">
            <Grid>
                <Button Content="← Назад" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Click="BackButton_Click"
                        HorizontalAlignment="Left"
                        Margin="20,0"/>
                <TextBlock x:Name="txtLessonTitle" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Область теории с WebBrowser -->
        <WindowsFormsHost Grid.Row="1" Margin="20">
            <wf:WebBrowser x:Name="webBrowser"/>
        </WindowsFormsHost>

        <!-- Кнопка перехода к вопросам -->
        <Button Grid.Row="2" 
                Content="Перейти к вопросам" 
                Background="#58CC02" 
                Foreground="White"
                FontSize="16" 
                FontWeight="Bold" 
                Width="200" 
                Height="50" 
                HorizontalAlignment="Center"
                Click="StartQuiz_Click"/>
    </Grid>
</Window>