<Window x:Class="LearnCodeWPF.ProjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Банк проектов — SteP()"
        Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        MinWidth="900" MinHeight="600">

    <Window.Resources>
        <SolidColorBrush x:Key="ColorSnow" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ColorPolar" Color="#F7F7F7"/>
        <SolidColorBrush x:Key="ColorSwan" Color="#E5E5E5"/>
        <SolidColorBrush x:Key="ColorHare" Color="#AFAFAF"/>
        <SolidColorBrush x:Key="ColorEel" Color="#4B4B4B"/>
        <SolidColorBrush x:Key="ColorMacaw" Color="#1CB0F6"/>
        <SolidColorBrush x:Key="ColorOwl" Color="#58CC02"/>
        <SolidColorBrush x:Key="ColorCardinal" Color="#FF4B4B"/>
        <SolidColorBrush x:Key="ColorBee" Color="#FFC800"/>

        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <SolidColorBrush x:Key="ColorWolf" Color="#777777"/>
    </Window.Resources>

    <Grid Background="{StaticResource ColorSnow}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковая панель навигации -->

        <!-- Основная область с проектами -->
        <Grid Grid.Column="1" Background="{StaticResource ColorPolar}">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0"
            Background="{StaticResource ColorSnow}"
            BorderBrush="{StaticResource ColorSwan}"
            BorderThickness="0,0,0,2">
                <Grid>
                    <TextBlock Text="Банк проектов"
               FontSize="22"
               FontWeight="Bold"
               Foreground="{StaticResource ColorEel}"
               VerticalAlignment="Center"
               Margin="20,0"/>
                    <Border Background="{StaticResource ColorPolar}"
            CornerRadius="20"
            Width="180"
            Height="40"
            HorizontalAlignment="Right"
            Margin="0,0,20,0">
                        <TextBlock Text="{Binding UserFIO}"
                   FontSize="11"
           FontWeight="Bold"
           Foreground="{StaticResource ColorMacaw}"
           VerticalAlignment="Center"
           HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Список проектов -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,20">
                    <TextBlock Text="Выберите проект для работы:"
               FontSize="18"
               FontWeight="Bold"
               Foreground="{StaticResource ColorEel}"
               Margin="0,0,0,20"/>
                    <ItemsControl x:Name="ProjectsList" ItemsSource="{Binding Projects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource ColorSnow}"
                    CornerRadius="12"
                    BorderBrush="{StaticResource ColorSwan}"
                    BorderThickness="1"
                    Margin="0,0,0,20"
                    Padding="20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Иконка проекта -->
                                        <Ellipse Grid.Column="0"
                     Width="60"
             Height="60"
             Fill="{Binding ProjectColor}">
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform x:Name="ProjectEllipseScale" ScaleX="1" ScaleY="1"/>
                                            </Ellipse.RenderTransform>
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="MouseDown">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <!-- Анимация сжатия по оси X -->
                                                            <DoubleAnimation Storyboard.TargetName="ProjectEllipseScale"
                              Storyboard.TargetProperty="ScaleX"
                              To="0.9"
                              Duration="0:0:0.1"/>
                                                            <!-- Анимация сжатия по оси Y -->
                                                            <DoubleAnimation Storyboard.TargetName="ProjectEllipseScale"
                              Storyboard.TargetProperty="ScaleY"
                              To="0.9" 
                                                                Duration="0:0:0.1"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                                <!-- Обратное восстановление размера при отпускании -->
                                                <EventTrigger RoutedEvent="MouseUp">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="ProjectEllipseScale"
                              Storyboard.TargetProperty="ScaleX"
                              To="1"
                              Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="ProjectEllipseScale"
                              Storyboard.TargetProperty="ScaleY"
                              To="1"
                              Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>

                                        <!-- Информация о проекте -->
                                        <StackPanel Grid.Column="1" Margin="20,0">
                                            <TextBlock Text="{Binding ProjectName}"
               FontSize="16"
               FontWeight="Bold"
               Foreground="{StaticResource ColorEel}"
               TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding MotivationText}"
               FontSize="11"
               Foreground="{StaticResource ColorHare}"
               TextWrapping="Wrap"
               Margin="0,5,0,0"/>
                                        </StackPanel>

                                        <!-- Статус проекта -->
                                        <TextBlock Grid.Column="2"
           Text="{Binding ProgressStatus}"
           FontSize="12"
           Foreground="{Binding StatusColor}"
           VerticalAlignment="Center"
           HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Border Grid.Column="0" 
            Background="{StaticResource ColorSnow}" 
            BorderBrush="{StaticResource ColorSwan}" 
            BorderThickness="0,0,2,0">
            <StackPanel>
                <Button Content="SteP()" 
                    FontSize="24" 
                    FontWeight="Bold"
                    Foreground="{StaticResource ColorEel}"
                    HorizontalAlignment="Left"
                    Margin="40,30,0,40"
                    Background="Transparent"
                    BorderThickness="0">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="SteP()" 
                                    FontSize="20"
                                    Foreground="{StaticResource ColorEel}"/>
                                <TextBlock Text="программирование" 
                                    FontSize="9"
                                    Foreground="{StaticResource ColorMacaw}"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                <StackPanel Margin="20,0">
                    
                        <TextBlock Text="💻 Обучение" 
                            FontSize="16"
                            Foreground="{StaticResource ColorHare}"
                            VerticalAlignment="Center"
                            Margin="10,0"/>
                   
                    <Border Background="Transparent" 
                        CornerRadius="4" 
                        Height="45"
                        Margin="0,0,0,15">
                        <TextBlock Text="👤 Профиль" 
                            FontSize="16"
                            Foreground="{StaticResource ColorHare}"
                            VerticalAlignment="Center"
                            Margin="10,0"/>
                    </Border>
                    <Border Background="Transparent" 
                        CornerRadius="4" 
                        Height="45"
                        Margin="0,0,0,15"
                        >
                        <TextBlock Text="⚡ Практика" 
                            FontSize="16"
                            Foreground="{StaticResource ColorHare}"
                            VerticalAlignment="Center"
                            Margin="10,0"/>
                    </Border>
                    <Border Background="#F0FFF0" 
                        CornerRadius="4" 
                        BorderBrush="{StaticResource ColorOwl}" 
                        BorderThickness="2"
                        Margin="0,0,0,15"
                        Height="45">
                        <TextBlock Text="📁 Проекты" 
                            FontSize="16"
                            Foreground="{StaticResource ColorOwl}"
                            VerticalAlignment="Center"
                            Margin="10,0"/>
                    </Border>
                    <Border Background="{StaticResource ColorPolar}" 
                        CornerRadius="8" 
                        Padding="15">
                        <StackPanel>
                            <TextBlock Text="ПРОГРЕСС" 
                                FontSize="11" 
                                FontWeight="Bold"
                                Foreground="{StaticResource ColorHare}"/>
                            <Border Background="{StaticResource ColorSwan}" 
                                Height="12" 
                                CornerRadius="6"
                                Margin="0,10,0,5">
                                <Border Background="{StaticResource ColorOwl}" 
                                    Width="{Binding ProgressWidth}" 
                                    CornerRadius="6"/>
                            </Border>
                            <TextBlock Text="{Binding ProgressPercent}" 
                                FontSize="10" 
                                FontWeight="Bold"
                                Foreground="{StaticResource ColorOwl}"
                                Margin="0,5,0,0"/>

                            <TextBlock Text="{Binding ProgressDetails}" 
                                FontSize="9"
                                Foreground="{StaticResource ColorWolf}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>