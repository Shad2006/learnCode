<Window x:Class="LearnCodeWPF.TeacherAnswers"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ответы ученика" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Ответы на вопросы" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
        <ScrollViewer Grid.Row="1">
            <ItemsControl x:Name="answersList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="LightGray" BorderThickness="1" Margin="5" Padding="10" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="{Binding Number, StringFormat='Вопрос {0}'}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding QuestionText}" TextWrapping="Wrap" Margin="0,5,0,5"/>
                                <TextBlock Text="{Binding UserAnswer, StringFormat='Ответ ученика: {0}'}" 
                                           Foreground="{Binding AnswerColor}" Margin="10,0,0,0"/>
                                <TextBlock Text="{Binding CorrectAnswer, StringFormat='Правильный ответ: {0}'}" 
                                           Foreground="Gray" FontSize="12" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>