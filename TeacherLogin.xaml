<Window x:Class="LearnCodeWPF.TeacherLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход для учителя" Height="300" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Background="#F7F7F7">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="280">
            <TextBlock Text="Введите пароль учителя" FontSize="16" Margin="0,0,0,20" TextAlignment="Center"/>
            <PasswordBox x:Name="pwdBox" FontSize="14" Height="35" Margin="0,0,0,20"/>
            <Button x:Name="btnLogin" Content="Войти" Background="#58CC02" 
                    Foreground="White" FontSize="14" Height="40" Click="BtnLogin_Click"/>
            <Button x:Name="btnCancel" Content="Отмена" Background="#FF4B4B" 
                    Foreground="White" FontSize="14" Height="40" Margin="0,10,0,0" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>