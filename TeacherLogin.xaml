<Window x:Class="LearnCodeWPF.TeacherLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход для учителя" Height="300" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.Resources>

        <Style x:Key="InputField" TargetType="PasswordBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#7AC70C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="OrangeRed"/>
        </Style>
    </Window.Resources>
    <Grid Background="#F7F7F7">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="280">
            <TextBlock Text="Введите пароль учителя" FontSize="16" Margin="0,0,0,20" TextAlignment="Center"/>

            <PasswordBox x:Name="pwdBox"  Style="{StaticResource InputField}"
                 FontSize="14" 
                 Height="35" 
                 VerticalAlignment="Center"/>
            <Border Margin="10"></Border>
            <Button x:Name="btnLogin" Content="Войти" MinHeight="40px" Style="{StaticResource ModernButton}" Click="BtnLogin_Click"/>
                <Button x:Name="btnCancel" Content="Отмена" MinHeight="35px" Style="{StaticResource DangerButton}" Margin="0,10,0,0" Click="BtnCancel_Click"/>

        </StackPanel>
    </Grid>
</Window>